{
  "id": "cloudflare-clef",
  "name": "Cloudflare CLEF decisions",
  "version": "0.1.3",
  "description": "Typed decision provider for Cloudflare Workers AI CLEF and CLEF Flash.",
  "contracts": {
    "decisionProviders": [
      "cloudflare-clef"
    ]
  },
  "decisionModels": [
    {
      "provider": "cloudflare-clef",
      "id": "clef-flash",
      "name": "Cloudflare CLEF Flash",
      "capabilities": {
        "questionTypes": [
          "boolean",
          "choice",
          "score"
        ],
        "maxQuestions": 64,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "requiresBooleanCriteria": false,
        "confidence": "provider-specific"
      }
    },
    {
      "provider": "cloudflare-clef",
      "id": "clef",
      "name": "Cloudflare CLEF",
      "capabilities": {
        "questionTypes": [
          "boolean",
          "choice",
          "score"
        ],
        "maxQuestions": 64,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "requiresBooleanCriteria": false,
        "confidence": "provider-specific"
      }
    }
  ],
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "apiToken",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "model": {
        "type": "string",
        "enum": [
          "clef",
          "clef-flash"
        ],
        "description": "Model toggle: use this CLEF model for every decision evaluation (clef = stronger, clef-flash = faster/cheaper). Omit to follow the consumer's selected decision model."
      },
      "accountId": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{32}$"
      },
      "apiToken": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "store"
                ]
              },
              "provider": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "provider",
              "id"
            ]
          }
        ]
      },
      "dailyNeuronCap": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000000,
        "description": "Optional local cap on Neurons spent by this plugin per UTC day (Cloudflare's free allocation is 10,000/day, shared with other Workers AI usage). Requests that would exceed it return unavailable/rate-limited until 00:00 UTC. Omit to disable."
      },
      "redact": {
        "type": "object",
        "additionalProperties": false,
        "description": "Optional redaction of decision evidence before it is sent to Cloudflare. Matches are replaced with stable per-request placeholders such as [ip-1].",
        "properties": {
          "privateIps": {
            "type": "boolean",
            "description": "Replace private, loopback, link-local and CGNAT IPv4 addresses and private IPv6 addresses."
          },
          "emails": {
            "type": "boolean",
            "description": "Replace e-mail addresses."
          },
          "patterns": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "pattern": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "flags": {
                      "type": "string",
                      "pattern": "^[imsu]*$"
                    }
                  },
                  "required": [
                    "pattern"
                  ]
                }
              ]
            },
            "description": "Extra JavaScript regular expressions (strings, or {pattern, flags}) whose matches are replaced with [redacted-N]."
          }
        }
      }
    }
  },
  "uiHints": {
    "model": {
      "label": "Model toggle (clef or clef-flash); omit to follow the selected decision model"
    },
    "accountId": {
      "label": "Cloudflare Account ID"
    },
    "apiToken": {
      "label": "Cloudflare Workers AI API Token",
      "sensitive": true
    },
    "dailyNeuronCap": {
      "label": "Daily Neuron cap (UTC day, optional)"
    },
    "redact": {
      "label": "Redact evidence before sending (optional)"
    }
  }
}
